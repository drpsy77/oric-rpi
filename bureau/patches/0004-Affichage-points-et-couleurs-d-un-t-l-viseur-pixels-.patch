diff --git a/include/video/renderer_display.h b/include/video/renderer_display.h
new file mode 100644
index 0000000..fce6134
--- /dev/null
+++ b/include/video/renderer_display.h
@@ -0,0 +1,57 @@
+/* SPDX-License-Identifier: EUPL-1.2 */
+/**
+ * @file renderer_display.h
+ * @brief Display settings of the SDL window: shape of the pixels and colours
+ *        of a television (ported from the oric-rpi bare-metal port,
+ *        kernel.cpp: pixels=, couleurs=, saturation=, luminosite=, rouge=…).
+ *
+ * Applied only when the image is shown (renderer_present): the emulated
+ * framebuffer, screenshots, videos and savestates keep the pure Oric colours.
+ */
+#ifndef RENDERER_DISPLAY_H
+#define RENDERER_DISPLAY_H
+
+#include <stdbool.h>
+#include <stdint.h>
+
+typedef enum {
+    DISPLAY_PIXELS_STRETCH = 0, /**< default: image stretched to the window */
+    DISPLAY_PIXELS_SQUARE,      /**< square pixels, proportions kept */
+    DISPLAY_PIXELS_TV           /**< 1.23:1 pixels (PAL TV), proportions kept */
+} display_pixels_t;
+
+typedef enum {
+    DISPLAY_COLORS_PURE = 0,    /**< 00/FF components (default) */
+    DISPLAY_COLORS_TV           /**< the colours of a television */
+} display_colors_t;
+
+typedef struct {
+    display_pixels_t pixels;
+    display_colors_t colors;
+    int saturation;             /**< percent, 100 = unchanged */
+    int brightness;             /**< percent, 100 = unchanged */
+    int32_t color[8];           /**< forced RRGGBB per Oric colour, -1 = none */
+} display_settings_t;
+
+/** Defaults: stretch, pure colours, 100 %, no forced colour. */
+void display_settings_init(display_settings_t* d);
+
+/** Parses a --pixels value: tv|tele, square|carres, stretch. */
+bool display_parse_pixels(const char* s, display_pixels_t* out);
+
+/** Parses a --colors value: tv|tele, pure|pures. */
+bool display_parse_colors(const char* s, display_colors_t* out);
+
+/** Parses NAME=RRGGBB (black…white or noir…blanc) into d->color[]. */
+bool display_parse_color(display_settings_t* d, const char* s);
+
+/** Computes the 8-colour palette (RGB888) from the settings. */
+void display_compute_palette(const display_settings_t* d, uint8_t pal[8][3]);
+
+/** True when the settings change nothing (upstream behaviour). */
+bool display_is_default(const display_settings_t* d);
+
+/** To call before renderer_init (window size follows the pixel shape). */
+void renderer_configure_display(const display_settings_t* d);
+
+#endif /* RENDERER_DISPLAY_H */
