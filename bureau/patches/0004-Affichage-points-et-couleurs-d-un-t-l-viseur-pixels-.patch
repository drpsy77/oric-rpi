@@ -117,9 +150,59 @@ void renderer_present(video_t* vid) {
             tex_w, tex_h);
         /* No SDL_RenderSetLogicalSize: SDL_RenderCopy fills the window. */
     }
+    /* Display palette: only the pure Oric colours are replaced (the ULA-NG
+     * extended colours are left as they are). */
+    if (disp_remap) {
+        const int n = src_w * src_h;
+        for (int i = 0; i < n; i++) {
+            const uint8_t* p = pixels + i * 3;
+            uint8_t* q = remapped + i * 3;
+            const uint8_t r = p[0], g = p[1], b = p[2];
+            if ((r == 0 || r == 0xFF) && (g == 0 || g == 0xFF) && (b == 0 || b == 0xFF)) {
+                const uint8_t* c = disp_pal[(r & 1) | (g & 2) | (b & 4)];
+                q[0] = c[0]; q[1] = c[1]; q[2] = c[2];
+            } else {
+                q[0] = r; q[1] = g; q[2] = b;
