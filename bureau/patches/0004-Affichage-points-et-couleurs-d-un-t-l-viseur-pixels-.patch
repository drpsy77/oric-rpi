+         * (src_w * ratio) : src_h inside the window, centred. */
+        int ow = 0, oh = 0;
+        SDL_GetRendererOutputSize(sdl_renderer, &ow, &oh);
+        const long iw = (long)src_w * pixel_ratio_x100(), ih = (long)src_h * 100;
+        SDL_Rect dst;
+        if ((long)ow * ih <= (long)oh * iw) {   /* width-limited */
+            dst.w = ow; dst.h = (int)((long)ow * ih / iw);
+        } else {
+            dst.h = oh; dst.w = (int)((long)oh * iw / ih);
