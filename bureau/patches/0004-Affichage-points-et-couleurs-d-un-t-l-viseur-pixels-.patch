+                if (opt == OPT_SATURATION) cfg->display.saturation = (int)v;
+                else cfg->display.brightness = (int)v;
+                break;
+            }
+            case OPT_COLOR:
+                if (!display_parse_color(&cfg->display, optarg)) {
+                    fprintf(stderr, "Invalid --color: %s (NAME=RRGGBB, NAME = black, red, green,\n"
+                                    "yellow, blue, magenta, cyan or white)\n", optarg);
+                    return 1;
