diff --git a/src/video/renderer_display.c b/src/video/renderer_display.c
new file mode 100644
index 0000000..1028f1d
--- /dev/null
+++ b/src/video/renderer_display.c
@@ -0,0 +1,91 @@
+/* SPDX-License-Identifier: EUPL-1.2 */
+/**
+ * @file renderer_display.c
+ * @brief Television display settings (palette computation and parsing).
+ *
+ * Ported from the oric-rpi bare-metal port (kernel.cpp, SetupDisplay): the
+ * TV colours are those of cpa-oric's remote console (tools/remote.html);
+ * saturation is applied around the grey of same luminance, then brightness.
+ */
+#include "video/renderer_display.h"
+#include <stdlib.h>
+#include <string.h>
+#include <strings.h>
+
+/* Television colours, in Oric order (bit 0 red, bit 1 green, bit 2 blue). */
+static const uint8_t tv_rgb[8][3] = {
+    {0x00, 0x00, 0x00}, {0xFF, 0x2A, 0x1A}, {0x2E, 0xC2, 0x2E}, {0xFD, 0xDE, 0x53},
+    {0x0A, 0x3C, 0xFF}, {0xEE, 0x22, 0xEE}, {0x18, 0xE8, 0xE8}, {0xFF, 0xFF, 0xFF}
+};
+
+static const char* const names_en[8] = {
+    "black", "red", "green", "yellow", "blue", "magenta", "cyan", "white" };
+static const char* const names_fr[8] = {
+    "noir", "rouge", "vert", "jaune", "bleu", "magenta", "cyan", "blanc" };
+
+void display_settings_init(display_settings_t* d) {
+    memset(d, 0, sizeof(*d));
+    d->saturation = 100;
+    d->brightness = 100;
+    for (int i = 0; i < 8; i++) d->color[i] = -1;
+}
+
+bool display_parse_pixels(const char* s, display_pixels_t* out) {
+    if (!s) return false;
+    if (!strcasecmp(s, "tv") || !strcasecmp(s, "tele") || !strcasecmp(s, "télé")) { *out = DISPLAY_PIXELS_TV; return true; }
+    if (!strcasecmp(s, "square") || !strcasecmp(s, "carres") || !strcasecmp(s, "carrés")) { *out = DISPLAY_PIXELS_SQUARE; return true; }
+    if (!strcasecmp(s, "stretch")) { *out = DISPLAY_PIXELS_STRETCH; return true; }
+    return false;
+}
+
+bool display_parse_colors(const char* s, display_colors_t* out) {
+    if (!s) return false;
+    if (!strcasecmp(s, "tv") || !strcasecmp(s, "tele") || !strcasecmp(s, "télé")) { *out = DISPLAY_COLORS_TV; return true; }
+    if (!strcasecmp(s, "pure") || !strcasecmp(s, "pures")) { *out = DISPLAY_COLORS_PURE; return true; }
+    return false;
+}
+
+bool display_parse_color(display_settings_t* d, const char* s) {
+    const char* eq = s ? strchr(s, '=') : NULL;
+    if (!eq) return false;
+    size_t n = (size_t)(eq - s);
+    const char* hex = eq + 1;
+    char* end;
+    unsigned long rgb = strtoul(hex, &end, 16);
+    if (*end != '\0' || end - hex != 6) return false;
+    for (int i = 0; i < 8; i++) {
+        if ((strlen(names_en[i]) == n && !strncasecmp(s, names_en[i], n)) ||
+            (strlen(names_fr[i]) == n && !strncasecmp(s, names_fr[i], n))) {
+            d->color[i] = (int32_t)rgb;
+            return true;
+        }
+    }
+    return false;
+}
+
+static uint8_t clamp255(int v) { return (uint8_t)(v < 0 ? 0 : v > 255 ? 255 : v); }
+
+void display_compute_palette(const display_settings_t* d, uint8_t pal[8][3]) {
+    for (int i = 0; i < 8; i++) {
+        uint8_t* p = pal[i];
+        for (int c = 0; c < 3; c++)
+            p[c] = d->colors == DISPLAY_COLORS_TV ? tv_rgb[i][c] : (uint8_t)(((i >> c) & 1) * 0xFF);
+        int gray = (p[0] * 77 + p[1] * 150 + p[2] * 29) >> 8;
+        for (int c = 0; c < 3; c++) {
+            int v = gray + (p[c] - gray) * d->saturation / 100;
+            p[c] = clamp255(v * d->brightness / 100);
+        }
+        if (d->color[i] >= 0) {
+            p[0] = (uint8_t)(d->color[i] >> 16);
+            p[1] = (uint8_t)(d->color[i] >> 8);
+            p[2] = (uint8_t)d->color[i];
+        }
+    }
+}
+
+bool display_is_default(const display_settings_t* d) {
+    if (d->pixels != DISPLAY_PIXELS_STRETCH || d->colors != DISPLAY_COLORS_PURE ||
+        d->saturation != 100 || d->brightness != 100) return false;
+    for (int i = 0; i < 8; i++) if (d->color[i] >= 0) return false;
+    return true;
+}
