+/* SPDX-License-Identifier: EUPL-1.2 */
+/**
+ * @file loci_disk_boot.h
+ * @brief --loci-disk GUEST: boot directly on a disk image of the LOCI
+ *        cartridge, without going through its menu (oric-rpi port,
+ *        locidisk.c, cmdline.txt locidisk=0:/cpa-en.dsk).
+ */
+#ifndef LOCI_DISK_BOOT_H
+#define LOCI_DISK_BOOT_H
+
+#include <stdbool.h>
+#include "emulator.h"
+
+/**
+ * Mounts GUEST (path as LOCI sees it, e.g. "0:/cpa.dsk") in drive A: of
+ * LOCI, writes the menu settings in XRAM (so the menu, F8, shows the image)
+ * and boots the Microdisc (BASIC 1.1 + microdis.rom from 0:), as the menu
+ * then ESC would. LOCI must be set up and its menu ROM loaded.
+ * @param modem  the modem (ACIA in $0380) is on: set in the menu settings
+ * @return false: nothing booted or boot incomplete (message logged)
+ */
+bool loci_disk_boot(emulator_t* emu, const char* guest, bool modem);
+
+#endif /* LOCI_DISK_BOOT_H */
