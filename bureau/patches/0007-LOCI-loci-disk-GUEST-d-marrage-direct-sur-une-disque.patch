--- /dev/null
+++ b/src/io/loci_disk_boot.c
@@ -0,0 +1,88 @@
+/* SPDX-License-Identifier: EUPL-1.2 */
+/**
+ * @file loci_disk_boot.c
+ * @brief --loci-disk GUEST: direct boot on a disk image of the LOCI.
+ *
+ * Ported from the oric-rpi bare-metal port (locidisk.c). Without it, the
+ * image has to be chosen in the LOCI menu, then ESC. This does what the menu
+ * and the firmware then do, with Phosphoric's own functions:
+ *   1. mount in drive A: of LOCI, as op_mount (loci_fs.c);
+ *   2. menu settings in XRAM, as loci-rom (persist.c; layout noted by
+ *      cpa-oric, docs/usb.md): the menu (F8) shows the image and CP/A
+ *      accepts the drive;
+ *   3. boot as op_mia_boot (loci_boot.c) with LOCI_BOOT_FDC and
+ *      LOCI_BOOT_B11: BASIC 1.1 at $C000, microdis.rom at $A000 (overlay).
+ */
+#include "io/loci_disk_boot.h"
+#include "io/loci_glue.h"
+#include "io/loci_internal.h"
+#include "utils/logging.h"
+
+#include <stdio.h>
+#include <string.h>
+#include <unistd.h>
+
+/* Menu settings in XRAM (loci-rom src/persist.h) */
+#define CFG_BASE    0x8000      /* "LOCI" */
+#define CFG_FDC_ON  0x04
+#define CFG_B11_ON  0x08
+#define CFG_SER_ON  0x09
+#define CFG_MOUNTS  0x0B        /* bit n: drive n, 4 tape, 5 ROM */
+#define CFG_PATH    0x0D        /* menu directory, 256 bytes */
+#define CFG_NAMES   0x10D       /* + 35 x n: file name only, 32 chars at most */
+#define CFG_NAME_SZ 35
+
+static bool resolve_rom(loci_t* loci, const char* name, char* out, size_t outsz) {
+    char guest[32];
+    snprintf(guest, sizeof(guest), "0:%s", name);
+    return resolve_path(loci, guest, out, outsz);
+}
+
+bool loci_disk_boot(emulator_t* emu, const char* guest, bool modem) {
+    loci_t* loci = &emu->loci;
+    char host[512];
+
+    /* 1. Mount (op_mount) */
+    if (!resolve_path(loci, guest, host, sizeof(host)) || access(host, R_OK) != 0) {
+        log_error("--loci-disk: %s not found", guest);
+        return false;
+    }
+    if (!loci_dsk_open(loci, 0, host)) {
+        log_error("--loci-disk: cannot mount %s", host);
+        return false;
+    }
+    loci->mnt_mounted[0] = true;
+    snprintf(loci->mnt_paths[0], sizeof(loci->mnt_paths[0]), "%s", guest);
+
+    /* 2. Menu settings: Microdisc, BASIC 1.1, A: mounted */
+    uint8_t* cfg = &loci->xram[CFG_BASE];
+    memset(cfg, 0, CFG_NAMES + CFG_NAME_SZ * LOCI_MNT_MAX);
+    memcpy(cfg, "LOCI", 4);
+    cfg[CFG_FDC_ON] = 1;
+    cfg[CFG_B11_ON] = 1;
+    cfg[CFG_SER_ON] = modem ? 1 : 0;
+    cfg[CFG_MOUNTS] = 0x01;
+    const char* name = strrchr(guest, '/');
+    name = name ? name + 1 : (guest[0] && guest[1] == ':' ? guest + 2 : guest);
+    size_t dir = (size_t)(name - guest);
+    if (dir > 1 && guest[dir - 1] == '/' && guest[dir - 2] != ':') dir--;   /* "1:/games/x" -> "1:/games" */
+    if (dir > 255) dir = 255;
+    memcpy(&cfg[CFG_PATH], guest, dir);
+    snprintf((char*)&cfg[CFG_NAMES], 33, "%s", name);
+
+    /* 3. Boot (op_mia_boot, FDC + BASIC 1.1) */
+    char rom[512], disc[512];
+    if (!resolve_rom(loci, "basic11b.rom", rom, sizeof(rom)) ||
+        !resolve_rom(loci, "microdis.rom", disc, sizeof(disc))) {
+        log_error("--loci-disk: ROM path too long");
+        return false;
+    }
+    loci->boot_settings = LOCI_BOOT_FDC | LOCI_BOOT_B11;
+    if (!loci_rom_swap_cb(emu, rom, 0xC000) || !loci_rom_swap_cb(emu, disc, 0xA000)) {
+        log_error("--loci-disk: cannot load %s or %s (they must be in the LOCI flash, 0:)",
+                  rom, disc);
+        return false;
+    }
+    log_info("--loci-disk: %s in A:, booting the Microdisc", guest);
+    return true;
+}
