 }
 
+TEST(test_fr_kma_file) {
+    /* Pierre's azerty.kma (oric-rpi sdcard/): same result as the built-in
+     * table for the signs, plus < -> \ ; a refused line does not stop it. */
+    const char* path = "/tmp/phosphoric_test_azerty.kma";
+    FILE* f = fopen(path, "w");
+    ASSERT_TRUE(f != NULL);
+    fputs("# test\n97 : 97\n113 : 113\n122 : 122\n119 : 119\n109 : 109\n44 : 44\n"
+          "38 : 49\n249 : 59\n42 : 39\n59 : 46\n58 : 47\n33 : 92\n60 : 92\n"
+          "999 : 1\n", f);
+    fclose(f);
+    ASSERT_EQ(oric_keyboard_load_kma(path), 13);
+    ASSERT_TRUE(fr_check(SDL_SCANCODE_Q, 6, 5));          /* a */
+    ASSERT_TRUE(fr_check(SDL_SCANCODE_1, 0, 5));          /* & key -> 1 */
+    ASSERT_TRUE(fr_check(SDL_SCANCODE_APOSTROPHE, 3, 2)); /* ù -> ; */
+    ASSERT_TRUE(fr_check(SDL_SCANCODE_NONUSBACKSLASH, 3, 6)); /* < -> \ */
+    ASSERT_TRUE(fr_check(SDL_SCANCODE_DELETE, 5, 5));     /* Suppr kept = DEL */
+    ASSERT_EQ(oric_keyboard_load_kma("/nonexistent.kma"), -1);
+    remove(path);
+}
+
 TEST(test_fr_ignores_textinput) {
     oric_keyboard_t kb;
