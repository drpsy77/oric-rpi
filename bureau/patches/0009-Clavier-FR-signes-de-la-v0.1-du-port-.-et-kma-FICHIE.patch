@@ -438,28 +440,119 @@ static const uint16_t fr_tab[64] = {
 };
 
 /* AZERTY: the key at a QWERTY position carries another label; return the
- * scancode of the QWERTY key with that label (oric-rpi: AzertyToQwerty). */
+ * scancode of the QWERTY key the ORIC should see (oric-rpi: AzertyToQwerty,
+ * signs chosen by Pierre as in Oricutron's keymap/azerty.kma — PC key ->
+ * ORIC key, Shift giving the second sign of the ORIC key):
+ * ù -> ;   * -> '   ; -> .   : -> /   ² and ! -> \ */
 static int fr_unmove(int sc) {
     switch (sc) {
-    case SDL_SCANCODE_Q:         return SDL_SCANCODE_A;          /* key A -> a */
-    case SDL_SCANCODE_A:         return SDL_SCANCODE_Q;          /* key Q -> q */
-    case SDL_SCANCODE_W:         return SDL_SCANCODE_Z;          /* key Z -> z */
-    case SDL_SCANCODE_Z:         return SDL_SCANCODE_W;          /* key W -> w */
-    case SDL_SCANCODE_SEMICOLON: return SDL_SCANCODE_M;          /* key M -> m */
-    case SDL_SCANCODE_M:         return SDL_SCANCODE_COMMA;      /* key , -> , */
-    case SDL_SCANCODE_COMMA:     return SDL_SCANCODE_SEMICOLON;  /* key ; -> ; */
-    case SDL_SCANCODE_DELETE:    return SDL_SCANCODE_BACKSPACE;  /* Suppr = DEL */
-    case SDL_SCANCODE_NONUSHASH: return SDL_SCANCODE_BACKSLASH;  /* ISO key * of AZERTY */
-    case SDL_SCANCODE_KP_ENTER:  return SDL_SCANCODE_RETURN;
-    default:                     return sc;
+    case SDL_SCANCODE_Q:          return SDL_SCANCODE_A;          /* key A -> a */
+    case SDL_SCANCODE_A:          return SDL_SCANCODE_Q;          /* key Q -> q */
+    case SDL_SCANCODE_W:          return SDL_SCANCODE_Z;          /* key Z -> z */
+    case SDL_SCANCODE_Z:          return SDL_SCANCODE_W;          /* key W -> w */
+    case SDL_SCANCODE_SEMICOLON:  return SDL_SCANCODE_M;          /* key M -> m */
+    case SDL_SCANCODE_M:          return SDL_SCANCODE_COMMA;      /* key , -> , */
+    case SDL_SCANCODE_COMMA:      return SDL_SCANCODE_PERIOD;     /* key ; -> . */
+    case SDL_SCANCODE_PERIOD:     return SDL_SCANCODE_SLASH;      /* key : -> / */
+    case SDL_SCANCODE_APOSTROPHE: return SDL_SCANCODE_SEMICOLON;  /* key ù -> ; */
+    case SDL_SCANCODE_NONUSHASH:                                  /* key * -> ' (ISO; */
+    case SDL_SCANCODE_BACKSLASH:  return SDL_SCANCODE_APOSTROPHE; /*   0x31 on some) */
+    case SDL_SCANCODE_GRAVE:                                      /* key ² -> \ */
+    case SDL_SCANCODE_SLASH:      return SDL_SCANCODE_BACKSLASH;  /* key ! -> \ */
+    case SDL_SCANCODE_DELETE:     return SDL_SCANCODE_BACKSPACE;  /* Suppr = DEL */
+    case SDL_SCANCODE_KP_ENTER:   return SDL_SCANCODE_RETURN;
+    default:                      return sc;
     }
 }
 
+/* PC scancode -> QWERTY scancode looked up in fr_tab (built-in table, or a
+ * correspondence file, oric_keyboard_load_kma). */
+static uint8_t fr_map[256];
+static bool fr_map_ready;
+
+static void fr_map_default(void) {
+    for (int i = 0; i < 256; i++) fr_map[i] = (uint8_t)fr_unmove(i);
+    fr_map_ready = true;
+}
+
+/* Oricutron key codes (SDL 1: the character of the key without Shift; 8, 9,
+ * 13, 27, 127, arrows 273-276) of each position, on a QWERTY keyboard (ORIC
+ * side of a .kma file) and on a French AZERTY one (PC side). oric-rpi:
+ * kernel.cpp, s_Layout. */
+static const struct { uint8_t sc; uint16_t qwerty, azerty; } kma_layout[] = {
+    { 0x04, 'a', 'q' }, { 0x05, 'b', 'b' }, { 0x06, 'c', 'c' }, { 0x07, 'd', 'd' },
+    { 0x08, 'e', 'e' }, { 0x09, 'f', 'f' }, { 0x0A, 'g', 'g' }, { 0x0B, 'h', 'h' },
+    { 0x0C, 'i', 'i' }, { 0x0D, 'j', 'j' }, { 0x0E, 'k', 'k' }, { 0x0F, 'l', 'l' },
+    { 0x10, 'm', ',' }, { 0x11, 'n', 'n' }, { 0x12, 'o', 'o' }, { 0x13, 'p', 'p' },
+    { 0x14, 'q', 'a' }, { 0x15, 'r', 'r' }, { 0x16, 's', 's' }, { 0x17, 't', 't' },
+    { 0x18, 'u', 'u' }, { 0x19, 'v', 'v' }, { 0x1A, 'w', 'z' }, { 0x1B, 'x', 'x' },
+    { 0x1C, 'y', 'y' }, { 0x1D, 'z', 'w' },
+    { 0x1E, '1', '&' }, { 0x1F, '2', 233 }, { 0x20, '3', '"' }, { 0x21, '4', '\'' },
+    { 0x22, '5', '(' }, { 0x23, '6', '-' }, { 0x24, '7', 232 }, { 0x25, '8', '_' },
+    { 0x26, '9', 231 }, { 0x27, '0', 224 },
+    { 0x28, 13, 13 }, { 0x29, 27, 27 }, { 0x2A, 8, 8 }, { 0x2B, 9, 9 }, { 0x2C, ' ', ' ' },
+    { 0x2D, '-', ')' }, { 0x2E, '=', '=' }, { 0x2F, '[', '^' }, { 0x30, ']', '$' },
+    { 0x31, '\\', '*' }, { 0x32, '#', '*' }, { 0x33, ';', 'm' }, { 0x34, '\'', 249 },
+    { 0x35, '`', 178 }, { 0x36, ',', ';' }, { 0x37, '.', ':' }, { 0x38, '/', '!' },
+    { 0x4C, 127, 127 }, { 0x4F, 275, 275 }, { 0x50, 276, 276 }, { 0x51, 274, 274 },
+    { 0x52, 273, 273 }, { 0x64, '\\', '<' }
+};
+
+static bool fr_is_oric_key(int sc) {
+    for (int j = 0; j < 64; j++) if (fr_tab[j] == sc) return true;
+    return false;
+}
+
+int oric_keyboard_load_kma(const char* path) {
+    FILE* f = fopen(path, "r");
+    if (!f) {
+        log_error("Keyboard: %s not found, built-in AZERTY table kept", path);
+        return -1;
+    }
+    /* A key absent from the file keeps its place (not the built-in signs). */
+    for (int i = 0; i < 256; i++) fr_map[i] = (uint8_t)i;
+    fr_map[SDL_SCANCODE_DELETE] = SDL_SCANCODE_BACKSPACE;
+    fr_map[SDL_SCANCODE_KP_ENTER] = SDL_SCANCODE_RETURN;
+    fr_map_ready = true;
+
+    const int n_layout = (int)(sizeof(kma_layout) / sizeof(kma_layout[0]));
+    int nline = 0, ok = 0;
+    char line[80];
+    while (fgets(line, sizeof(line), f)) {
+        nline++;
+        line[strcspn(line, "#\r\n")] = '\0';           /* comment, end of line */
+        unsigned host, oric;
+        char end;
+        int nf = sscanf(line, "%u : %u %c", &host, &oric, &end);
+        if (nf <= 0) continue;                          /* empty line */
+        int target = -1;                                /* QWERTY position of the ORIC key */
+        for (int k = 0; k < n_layout; k++)
+            if (kma_layout[k].qwerty == oric && fr_is_oric_key(kma_layout[k].sc)) {
+                target = kma_layout[k].sc;
+                break;
+            }
+        bool found = false;                             /* every PC key with this sign */
+        for (int k = 0; nf == 2 && target >= 0 && k < n_layout; k++)
+            if (kma_layout[k].azerty == host) {
+                fr_map[kma_layout[k].sc] = (uint8_t)target;
+                found = true;
+            }
+        if (found) ok++;
+        else log_warning("Keyboard: %s line %d refused: %s", path, nline, line);
+    }
+    fclose(f);
+    log_info("Keyboard: %s, %d correspondence(s) (AZERTY keyboard)", path, ok);
+    return ok;
+}
+
 static bool handle_fr(oric_keyboard_t* kb, const SDL_Event* event) {
     if (event->type != SDL_KEYDOWN && event->type != SDL_KEYUP)
         return false;   /* SDL_TEXTINPUT is not used */
 
-    int sc = fr_unmove((int)event->key.keysym.scancode);
+    if (!fr_map_ready) fr_map_default();
+    int sc = (int)event->key.keysym.scancode;
+    if (sc < 0 || sc > 255) return false;
+    sc = fr_map[sc];
     bool down = (event->type == SDL_KEYDOWN);
 
     for (int i = 0; i < 64; i++) {
