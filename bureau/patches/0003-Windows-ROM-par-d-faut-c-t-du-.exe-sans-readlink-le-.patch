---
 src/main.c | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/src/main.c b/src/main.c
index 6a25644..a3cd049 100644
--- a/src/main.c
+++ b/src/main.c
@@ -77,6 +77,9 @@
 #include "utils/cycle_trace.h"
 #include "cpu/microseq.h"
 #include "utils/rominfo.h"
+#ifdef _WIN32
+#include <windows.h>   /* GetModuleFileNameA (default ROM next to the .exe) */
+#endif
 
 /* System ROM of the minimal profile when -r is absent: bare ORIC-1 (BASIC 1.0),
  * or BASIC 1.1 if -m atmos asks for it. */
@@ -3198,8 +3201,14 @@ static int main_setup_rom_model(emulator_t* emu, cli_opts_t* cfg) {
             cfg->rom_file = rom;
         } else {
             char self[1024];
+#ifdef _WIN32
+            /* No /proc on Windows: the executable's path from the system. */
+            DWORD n = GetModuleFileNameA(NULL, self, sizeof(self) - 1);
+            char* slash = n > 0 ? (self[n] = '\0', strrchr(self, '\\')) : NULL;
+#else
             ssize_t n = readlink("/proc/self/exe", self, sizeof(self) - 1);
             char* slash = n > 0 ? (self[n] = '\0', strrchr(self, '/')) : NULL;
+#endif
             if (slash) {
                 *slash = '\0';
                 snprintf(default_rom, sizeof(default_rom), "%s/%s", self, rom);
