diff --git a/include/storage/disk_autosave.h b/include/storage/disk_autosave.h
new file mode 100644
index 0000000..fc11244
--- /dev/null
+++ b/include/storage/disk_autosave.h
@@ -0,0 +1,32 @@
+/* SPDX-License-Identifier: EUPL-1.2 */
+/**
+ * @file disk_autosave.h
+ * @brief --disk-autosave: modified disk images written back to their .dsk
+ *        files shortly after the Oric's last write, track by track.
+ *
+ * Phosphoric keeps each floppy in memory and writes it back only on exit
+ * (--disk-writeback, Microdisc), never for an MFM_DISK served by LOCI
+ * ("session-only"). The real LOCI writes to its USB key as it goes. Ported
+ * from the oric-rpi bare-metal port (disquette.c), where the power is simply
+ * switched off.
+ */
+#ifndef DISK_AUTOSAVE_H
+#define DISK_AUTOSAVE_H
+
+#include <stdbool.h>
+#include "emulator.h"
+
+/** Frames without a write before the write-back (2 s at 50 Hz). */
+#define DISK_AUTOSAVE_QUIET_FRAMES 100
+
+void disk_autosave_enable(bool on);
+bool disk_autosave_enabled(void);
+
+/** At the end of each frame: notes the writes, writes back the changed
+ *  tracks after DISK_AUTOSAVE_QUIET_FRAMES frames without one. */
+void disk_autosave_service(emulator_t* emu);
+
+/** Writes back at once what has changed (exit, disk swap). */
+void disk_autosave_flush(emulator_t* emu);
+
+#endif /* DISK_AUTOSAVE_H */
