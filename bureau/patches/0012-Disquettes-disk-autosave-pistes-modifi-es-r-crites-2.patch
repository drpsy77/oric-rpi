diff --git a/src/storage/disk_autosave.c b/src/storage/disk_autosave.c
new file mode 100644
index 0000000..b60c38b
--- /dev/null
+++ b/src/storage/disk_autosave.c
@@ -0,0 +1,170 @@
+/* SPDX-License-Identifier: EUPL-1.2 */
+/**
+ * @file disk_autosave.c
+ * @brief --disk-autosave: track-by-track write-back of modified floppies.
+ *
+ * Ported from the oric-rpi bare-metal port (disquette.c). For each mounted
+ * floppy (Microdisc drives, LOCI drives) the state of its file is kept
+ * (sedoric_load: flat sectors and MFM container). DISK_AUTOSAVE_QUIET_FRAMES
+ * frames after the Oric's last write, the in-memory image is compared with
+ * it track by track and only the changed tracks are written in place (6400
+ * bytes for an MFM_DISK, sectors re-encoded and CRCs recomputed by
+ * mfm_inject_track; sectors x 256 bytes for a raw image). An interruption
+ * during the write only damages one track.
+ *
+ * Under Emscripten, Module.phosDiskSaved(path) is called after each write,
+ * so the page can persist the file (IndexedDB) or offer it for download.
+ */
+#include "storage/disk_autosave.h"
+#include "storage/sedoric.h"
+#include "utils/logging.h"
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#ifdef __EMSCRIPTEN__
+#include <emscripten.h>
+#endif
+
+#define N_DRIVES 4
+
+/* State of the file of a mounted floppy */
+typedef struct {
+    const uint8_t*  image;      /* Phosphoric's image (key, with the path) */
+    char            path[256];
+    sedoric_disk_t* file;       /* contents of the file; NULL: to read again */
+    bool            refused;    /* different geometry: file left alone */
+} file_copy_t;
+
+static bool enabled;
+static file_copy_t loci_copy[N_DRIVES], md_copy[N_DRIVES];
+static uint32_t md_writes_seen;
+static int quiet = -1;          /* frames since the last write; -1: nothing */
+
+void disk_autosave_enable(bool on) { enabled = on; }
+bool disk_autosave_enabled(void) { return enabled; }
+
+static void forget(file_copy_t* c) {
+    sedoric_destroy(c->file);
+    memset(c, 0, sizeof(*c));
+}
+
+static void notify_saved(const char* path) {
+#ifdef __EMSCRIPTEN__
+    /* EM_ASM needs -std=gnu*: a script, with the path as a JS string. */
+    char js[600];
+    int n = snprintf(js, sizeof(js), "Module.phosDiskSaved && Module.phosDiskSaved(\"");
+    for (const char* p = path; *p && n < (int)sizeof(js) - 8; p++) {
+        if (*p == '"' || *p == '\\') js[n++] = '\\';
+        js[n++] = *p;
+    }
+    snprintf(js + n, sizeof(js) - (size_t)n, "\")");
+    emscripten_run_script(js);
+#else
+    (void)path;
+#endif
+}
+
+/* Writes back into the file the tracks where the image differs from it. */
+static void save(file_copy_t* c, const uint8_t* image, uint32_t size, const char* path) {
+    if (c->image != image || strncmp(c->path, path, sizeof(c->path)) != 0) {
+        forget(c);              /* another floppy in the drive */
+        c->image = image;
+        strncpy(c->path, path, sizeof(c->path) - 1);
+    }
+    if (c->refused) return;
+
+    if (!c->file) {
+        c->file = sedoric_load(path);
+        if (!c->file || c->file->size != size || c->file->sectors == 0) {
+            log_warning("Disk autosave: %s: geometry differs from the mounted image, not written back", path);
+            sedoric_destroy(c->file);
+            c->file = NULL;
+            c->refused = true;
+            return;
+        }
+    }
+
+    sedoric_disk_t* f = c->file;
+    const uint32_t track = (uint32_t)f->sectors * SEDORIC_SECTOR_SIZE;
+    FILE* fp = NULL;
+    int n = 0;
+    bool failed = false;
+    for (uint32_t k = 0; k < size / track; k++) {
+        const uint32_t off = k * track;
+        if (memcmp(image + off, f->data + off, track) == 0) continue;
+        memcpy(f->data + off, image + off, track);
+
+        /* Track k of the file: side 0 then side 1, as sedoric_load */
+        const uint8_t* block = f->data + off;
+        long pos = (long)off;
+        size_t len = track;
+        if (f->is_mfm) {
+            pos = MFM_DISK_HEADER_SIZE + (long)k * MFM_TRACK_SIZE;
+            if (pos + MFM_TRACK_SIZE > (long)f->mfm_raw_size) continue;
+            mfm_inject_track(&f->mfm_raw[pos], f->data, f->size, f->sectors, f->tracks);
+            block = &f->mfm_raw[pos];
+            len = MFM_TRACK_SIZE;
+        }
+
+        if (!fp && !(fp = fopen(path, "r+b"))) { failed = true; break; }
+        if (fseek(fp, pos, SEEK_SET) != 0 || fwrite(block, 1, len, fp) != len) { failed = true; break; }
+        n++;
+    }
+    if (fp && fclose(fp) != 0) failed = true;
+
+    if (failed) {
+        /* file in an unknown state: read again at the next write-back */
+        log_error("Disk autosave: %s: write-back failed", path);
+        sedoric_destroy(c->file);
+        c->file = NULL;
+    } else if (n > 0) {
+        log_info("Disk autosave: %s: %d track(s) written back", path, n);
+        notify_saved(path);
+    }
+}
+
+void disk_autosave_service(emulator_t* emu) {
+    if (!enabled) return;
+    /* Writes of the last frame. LOCI does not read disk_modified (cleared
+     * here); the Microdisc keeps disk_dirty for --disk-writeback and the F1
+     * menu, so its write counter is used instead. */
+    bool wrote = false;
+    if (emu->card_on[CARD_IDX_loci] && emu->loci.dsk_fdc.disk_modified) {
+        emu->loci.dsk_fdc.disk_modified = false;
+        wrote = true;
+    }
+    if (emu->card_on[CARD_IDX_microdisc] && emu->microdisc.disk_writes != md_writes_seen) {
+        md_writes_seen = emu->microdisc.disk_writes;
+        wrote = true;
+    }
+    if (wrote) {
+        quiet = 0;
+        return;
+    }
+    if (quiet < 0 || ++quiet < DISK_AUTOSAVE_QUIET_FRAMES) return;
+    disk_autosave_flush(emu);
+}
+
+void disk_autosave_flush(emulator_t* emu) {
+    if (!enabled) return;
+    quiet = -1;
+
+    /* LOCI floppies (dsk_image: flat sectors, as sedoric_load) */
+    for (int d = 0; d < N_DRIVES; d++) {
+        const loci_t* l = &emu->loci;
+        if (emu->card_on[CARD_IDX_loci] && l->dsk_image[d] && !l->dsk_web[d] && l->dsk_host_path[d][0])
+            save(&loci_copy[d], l->dsk_image[d], l->dsk_image_size[d], l->dsk_host_path[d]);
+        else
+            forget(&loci_copy[d]);
+    }
+    /* Microdisc floppies (disk_paths[] follows the F1 menu swaps) */
+    for (int d = 0; d < N_DRIVES; d++) {
+        const sedoric_disk_t* disk = emu->disks[d];
+        if (emu->card_on[CARD_IDX_microdisc] && disk && disk->data && emu->disk_paths[d])
+            save(&md_copy[d], disk->data, disk->size, emu->disk_paths[d]);
+        else
+            forget(&md_copy[d]);
+    }
+}
