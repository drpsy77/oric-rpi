 Makefile | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/Makefile b/Makefile
index a1490f4..354ec89 100644
--- a/Makefile
+++ b/Makefile
@@ -62,6 +62,9 @@ ifeq ($(WIN), 1)
     EXE = .exe
     SDL2_WIN_PREFIX ?= /opt/sdl2-mingw/x86_64-w64-mingw32
     LDFLAGS = -lm -lws2_32 -lwinpthread -static-libgcc
+    # emulator_t (~2.7 MB) lives on main()'s stack: Windows gives 1 MB by
+    # default → stack overflow at startup. 16 MB, as on Linux (8 MB) + margin.
+    LDFLAGS += -Wl,--stack,16777216
     PICOTLS = 0
 endif
 
