  * The character -> ORIC mapping is derived from the ORIC-1 BASIC 1.0 ROM
  * keyboard decode tables at $FF70 (unshifted) and $FFB0 (shifted).
  *
+ * FR (positional AZERTY): each physical key goes to the ORIC key at the
+ * same place, read from the SDL scancode (= USB HID usage, independent of
+ * the host layout). The letters that AZERTY moves (A/Q, Z/W, M) and the
+ * comma / semicolon keys are brought back to their label, so the PC key
+ * marked "A" types A. The digit row gives digits without Shift, as on the
+ * ORIC. Ported from the oric-rpi bare-metal port (kernel.cpp, keymap=FR).
+ *
  * Key mapping tables based on Oricutron by Peter Gordon (GPL v2).
  */
 
@@ -408,11 +415,72 @@ static bool handle_symbolic(oric_keyboard_t* kb, const SDL_Event* event) {
     return false;
 }
 
+
+/* ================================================================
+ * FR positional mapping (French AZERTY keyboard, by scancode)
+ * ================================================================
+ *
+ * Same layout as qwerty_tab, but with SDL scancodes, which are the USB HID
+ * usage codes: the table is the one of the oric-rpi port (kernel.cpp,
+ * s_OricKeys), where a USB keyboard is read in raw mode. Scancodes follow
+ * the physical position of the keys whatever the host layout, so the
+ * AZERTY-moved letters are brought back to their label by fr_unmove().
+ */
+static const uint16_t fr_tab[64] = {
+    /* Col 0 */ SDL_SCANCODE_7, SDL_SCANCODE_N, SDL_SCANCODE_5, SDL_SCANCODE_V, SDL_SCANCODE_RCTRL,  SDL_SCANCODE_1,         SDL_SCANCODE_X,            SDL_SCANCODE_3,
+    /* Col 1 */ SDL_SCANCODE_J, SDL_SCANCODE_T, SDL_SCANCODE_R, SDL_SCANCODE_F, 0,                   SDL_SCANCODE_ESCAPE,    SDL_SCANCODE_Q,            SDL_SCANCODE_D,
+    /* Col 2 */ SDL_SCANCODE_M, SDL_SCANCODE_6, SDL_SCANCODE_B, SDL_SCANCODE_4, SDL_SCANCODE_LCTRL,  SDL_SCANCODE_Z,         SDL_SCANCODE_2,            SDL_SCANCODE_C,
+    /* Col 3 */ SDL_SCANCODE_K, SDL_SCANCODE_9, SDL_SCANCODE_SEMICOLON, SDL_SCANCODE_MINUS, 0,       0,                      SDL_SCANCODE_BACKSLASH,    SDL_SCANCODE_APOSTROPHE,
+    /* Col 4 */ SDL_SCANCODE_SPACE, SDL_SCANCODE_COMMA, SDL_SCANCODE_PERIOD, SDL_SCANCODE_UP, SDL_SCANCODE_LSHIFT, SDL_SCANCODE_LEFT, SDL_SCANCODE_DOWN,    SDL_SCANCODE_RIGHT,
+    /* Col 5 */ SDL_SCANCODE_U, SDL_SCANCODE_I, SDL_SCANCODE_O, SDL_SCANCODE_P, SDL_SCANCODE_LALT,   SDL_SCANCODE_BACKSPACE, SDL_SCANCODE_RIGHTBRACKET, SDL_SCANCODE_LEFTBRACKET,
+    /* Col 6 */ SDL_SCANCODE_Y, SDL_SCANCODE_H, SDL_SCANCODE_G, SDL_SCANCODE_E, SDL_SCANCODE_RALT,   SDL_SCANCODE_A,         SDL_SCANCODE_S,            SDL_SCANCODE_W,
+    /* Col 7 */ SDL_SCANCODE_8, SDL_SCANCODE_L, SDL_SCANCODE_0, SDL_SCANCODE_SLASH, SDL_SCANCODE_RSHIFT, SDL_SCANCODE_RETURN, SDL_SCANCODE_GRAVE,      SDL_SCANCODE_EQUALS
+};
+
+/* AZERTY: the key at a QWERTY position carries another label; return the
+ * scancode of the QWERTY key with that label (oric-rpi: AzertyToQwerty). */
+static int fr_unmove(int sc) {
+    switch (sc) {
+    case SDL_SCANCODE_Q:         return SDL_SCANCODE_A;          /* key A -> a */
+    case SDL_SCANCODE_A:         return SDL_SCANCODE_Q;          /* key Q -> q */
+    case SDL_SCANCODE_W:         return SDL_SCANCODE_Z;          /* key Z -> z */
+    case SDL_SCANCODE_Z:         return SDL_SCANCODE_W;          /* key W -> w */
+    case SDL_SCANCODE_SEMICOLON: return SDL_SCANCODE_M;          /* key M -> m */
+    case SDL_SCANCODE_M:         return SDL_SCANCODE_COMMA;      /* key , -> , */
+    case SDL_SCANCODE_COMMA:     return SDL_SCANCODE_SEMICOLON;  /* key ; -> ; */
+    case SDL_SCANCODE_DELETE:    return SDL_SCANCODE_BACKSPACE;  /* Suppr = DEL */
+    case SDL_SCANCODE_NONUSHASH: return SDL_SCANCODE_BACKSLASH;  /* ISO key * of AZERTY */
+    case SDL_SCANCODE_KP_ENTER:  return SDL_SCANCODE_RETURN;
+    default:                     return sc;
+    }
+}
+
+static bool handle_fr(oric_keyboard_t* kb, const SDL_Event* event) {
+    if (event->type != SDL_KEYDOWN && event->type != SDL_KEYUP)
+        return false;   /* SDL_TEXTINPUT is not used */
+
+    int sc = fr_unmove((int)event->key.keysym.scancode);
+    bool down = (event->type == SDL_KEYDOWN);
+
+    for (int i = 0; i < 64; i++) {
+        if (fr_tab[i] != 0 && fr_tab[i] == sc) {
+            int col = i / 8;
+            int row = i % 8;
+            if (down) kb->matrix[col] &= ~(1 << row);
+            else      kb->matrix[col] |= (1 << row);
+            return true;
+        }
+    }
+    return false;
+}
+
 /* ================================================================
  * Public API
  * ================================================================ */
 
 bool oric_keyboard_handle_sdl_event(oric_keyboard_t* kb, const SDL_Event* event) {
+    if (kb->layout == ORIC_KB_FR)
+        return handle_fr(kb, event);
     if (kb->layout == ORIC_KB_AZERTY)
         return handle_symbolic(kb, event);
     return handle_qwerty(kb, event);
