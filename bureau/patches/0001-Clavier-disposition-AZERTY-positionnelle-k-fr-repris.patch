+/* ═══ FR positional layout (-k fr) ═══ */
+
+/* key at (col,row) pressed after a KEYDOWN of scancode sc, released after KEYUP */
+static int fr_check(SDL_Scancode sc, int col, int row) {
+    oric_keyboard_t kb;
+    oric_keyboard_init(&kb);
+    oric_keyboard_set_layout(&kb, ORIC_KB_FR);
+    SDL_Event d = make_keydown(SDLK_UNKNOWN, sc);
+    if (!oric_keyboard_handle_sdl_event(&kb, &d)) return 0;
+    for (int c = 0; c < 8; c++) {
+        uint8_t want = c == col ? (uint8_t)~(1 << row) : 0xFF;
+        if (kb.matrix[c] != want) return 0;
+    }
+    SDL_Event u = make_keyup(SDLK_UNKNOWN, sc);
+    oric_keyboard_handle_sdl_event(&kb, &u);
+    for (int c = 0; c < 8; c++) if (kb.matrix[c] != 0xFF) return 0;
+    return 1;
+}
+
+TEST(test_fr_letters_by_label) {
+    ASSERT_TRUE(fr_check(SDL_SCANCODE_Q, 6, 5));          /* AZERTY key A -> A */
+    ASSERT_TRUE(fr_check(SDL_SCANCODE_A, 1, 6));          /* AZERTY key Q -> Q */
+    ASSERT_TRUE(fr_check(SDL_SCANCODE_W, 2, 5));          /* AZERTY key Z -> Z */
+    ASSERT_TRUE(fr_check(SDL_SCANCODE_Z, 6, 7));          /* AZERTY key W -> W */
+    ASSERT_TRUE(fr_check(SDL_SCANCODE_SEMICOLON, 2, 0));  /* AZERTY key M -> M */
+    ASSERT_TRUE(fr_check(SDL_SCANCODE_M, 4, 1));          /* AZERTY key , -> , */
+    ASSERT_TRUE(fr_check(SDL_SCANCODE_COMMA, 3, 2));      /* AZERTY key ; -> ; */
+    ASSERT_TRUE(fr_check(SDL_SCANCODE_E, 6, 3));          /* unmoved letter */
+}
+
+TEST(test_fr_digits_without_shift) {
+    ASSERT_TRUE(fr_check(SDL_SCANCODE_1, 0, 5));
+    ASSERT_TRUE(fr_check(SDL_SCANCODE_7, 0, 0));
+    ASSERT_TRUE(fr_check(SDL_SCANCODE_0, 7, 2));
+}
+
+TEST(test_fr_specials_and_modifiers) {
+    ASSERT_TRUE(fr_check(SDL_SCANCODE_DELETE, 5, 5));     /* Suppr = DEL */
+    ASSERT_TRUE(fr_check(SDL_SCANCODE_BACKSPACE, 5, 5));
+    ASSERT_TRUE(fr_check(SDL_SCANCODE_RETURN, 7, 5));
+    ASSERT_TRUE(fr_check(SDL_SCANCODE_ESCAPE, 1, 5));
+    ASSERT_TRUE(fr_check(SDL_SCANCODE_LSHIFT, 4, 4));
+    ASSERT_TRUE(fr_check(SDL_SCANCODE_RSHIFT, 7, 4));
+    ASSERT_TRUE(fr_check(SDL_SCANCODE_LCTRL, 2, 4));
+    ASSERT_TRUE(fr_check(SDL_SCANCODE_LALT, 5, 4));       /* Alt = FUNCT */
+    ASSERT_TRUE(fr_check(SDL_SCANCODE_UP, 4, 3));
+}
+
+TEST(test_fr_ignores_textinput) {
+    oric_keyboard_t kb;
+    oric_keyboard_init(&kb);
+    oric_keyboard_set_layout(&kb, ORIC_KB_FR);
+    SDL_Event ev;
+    memset(&ev, 0, sizeof(ev));
+    ev.type = SDL_TEXTINPUT;
+    ev.text.text[0] = 'a';
+    ASSERT_TRUE(!oric_keyboard_handle_sdl_event(&kb, &ev));
+    for (int c = 0; c < 8; c++) ASSERT_EQ(kb.matrix[c], 0xFF);
+}
+
